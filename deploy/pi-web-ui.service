# omp-web-ui systemd unit — Linux auto-start on boot.
#
# Install (adjust User/WorkingDirectory/Environment to taste):
#   sudo npm i -g omp-web-ui
#   sudo cp deploy/omp-web-ui.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now omp-web-ui
#   sudo systemctl status omp-web-ui
#
# Logs: journalctl -u omp-web-ui -f

[Unit]
Description=omp-web-ui — web chat for the pi coding agent
After=network.target

[Service]
Type=simple
# Run as an unprivileged user (change to your user, e.g. yourname)
User=YOUR_USER
# The workspace the agent operates in (read/edit/bash/write)
WorkingDirectory=/home/YOUR_USER
Environment=PORT=8787
# Point at your pi config dir if it's not the default ~/.omp/agent
#Environment=OMP_WEB_AGENT_DIR=/home/YOUR_USER/.omp/agent
ExecStart=/usr/bin/omp-web-ui
Restart=on-failure
RestartSec=5
# npm global bin may live elsewhere (nvm, etc.) — find with: which omp-web-ui

[Install]
WantedBy=multi-user.target
