<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  pi-harness launchd agent — macOS auto-start at login.

  Install:
    npm i -g @youweichen/pi-harness
    cp deploy/com.youweichen.pi-harness.plist ~/Library/LaunchAgents/
    # edit ProgramArguments / WorkingDirectory / PI_WEB_CWD for your setup
    launchctl load ~/Library/LaunchAgents/com.youweichen.pi-harness.plist
    # (or: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.youweichen.pi-harness.plist)

  Find the pi-harness binary path with: which pi-harness
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.youweichen.pi-harness</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/pi-harness</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it crashes -->
  <key>KeepAlive</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>8787</string>
    <key>PI_WEB_CWD</key>
    <string>/Users/YOUR_USER</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/pi-harness.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pi-harness.err</string>
</dict>
</plist>
