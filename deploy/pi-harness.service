# pi-harness systemd unit — Linux auto-start on boot.
#
# Install (adjust User/WorkingDirectory/Environment to taste):
#   sudo npm i -g pi-harness
#   sudo cp deploy/pi-harness.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pi-harness
#   sudo systemctl status pi-harness
#
# Logs: journalctl -u pi-harness -f

[Unit]
Description=pi-harness — web chat for the pi coding agent
After=network.target

[Service]
Type=simple
# Run as an unprivileged user (change to your user, e.g. yourname)
User=YOUR_USER
# The workspace the agent operates in (read/edit/bash/write)
WorkingDirectory=/home/YOUR_USER
Environment=PORT=8787
# Point at your pi config dir if it's not the default ~/.pi/agent
#Environment=PI_CODING_AGENT_DIR=/home/YOUR_USER/.pi/agent
ExecStart=/usr/bin/pi-harness
Restart=on-failure
RestartSec=5
# npm global bin may live elsewhere (nvm, etc.) — find with: which pi-harness

[Install]
WantedBy=multi-user.target
