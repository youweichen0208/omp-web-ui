{
  "name": "@youweichen/pi-harness",
  "version": "1.3.1",
  "description": "Web chat interface for the pi coding agent, powered by the pi SDK (@earendil-works/pi-coding-agent) — one-command run, Docker/systemd/launchd deployable",
  "license": "MIT",
  "author": {
    "name": "youweichen",
    "email": "youweichen0208@gmail.com"
  },
  "type": "module",
  "bin": {
    "pi-harness": "bin/pi-harness.mjs"
  },
  "main": "electron/main.mjs",
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "web/public/",
    "deploy/",
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "coding-agent",
    "ai",
    "chat",
    "web-ui",
    "terminal",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youweichen0208/pi-harness.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env PORT=8788 PI_WEB_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --import tsx server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --test tests/check-design-tokens-test.mjs && npm run check:design && vitest run",
    "test:unit": "vitest run",
    "test:context-eval": "node --test tests/context-corpus-test.mjs tests/context-eval-test.mjs tests/context-session-test.mjs tests/context-pi-model-test.mjs",
    "test:smoke": "node tests/run-smoke.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:protocol": "node scripts/check-protocol-sync.mjs",
    "test:freeze": "node tests/freeze-test.mjs",
    "start": "node dist/server/index.js",
    "start:electron": "electron .",
    "dev:electron": "electron .",
    "build:electron": "electron-builder build",
    "build:electron:mac": "electron-builder build --mac",
    "build:electron:win": "electron-builder build --win",
    "build:electron:linux": "electron-builder build --linux",
    "publish:electron": "electron-builder build --publish always",
    "check:design": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "compression": "^1.8.1",
    "electron-updater": "^6.0.0",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.4.299",
    "proper-lockfile": "4.1.2",
    "remark-parse": "^11.0.0",
    "ssh2": "^1.17.0",
    "typebox": "^1.3.14",
    "unified": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.10.0",
    "mermaid": "^11.17.2",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@41.10.7": true
  }
}
