{
  "name": "@youweichen/omp-web-ui",
  "version": "1.0.0-beta.1",
  "description": "OMP Web and desktop interface for Oh My Pi, with a bundled Bun runtime",
  "license": "MIT",
  "author": {
    "name": "youweichen",
    "email": "youweichen0208@gmail.com"
  },
  "type": "module",
  "bin": {
    "omp-web-ui": "bin/omp-web-ui.mjs"
  },
  "main": "electron/main.mjs",
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "web/public/",
    "deploy/",
    "extensions/",
    "README.md",
    "LICENSE",
    "omp-worker/"
  ],
  "keywords": [
    "oh-my-pi",
    "omp",
    "coding-agent",
    "ai",
    "chat",
    "web-ui",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youweichen0208/omp-web-ui.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env PORT=8788 OMP_WEB_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --import tsx server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.extensions.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "node tests/run-smoke.mjs",
    "check:protocol": "node scripts/check-protocol-sync.mjs",
    "test:freeze": "node tests/freeze-test.mjs",
    "start": "node dist/server/index.js",
    "start:electron": "electron .",
    "dev:electron": "electron .",
    "build:electron": "electron-builder build",
    "build:electron:mac": "electron-builder build --mac",
    "build:electron:win": "electron-builder build --win",
    "build:electron:linux": "electron-builder build --linux",
    "publish:electron": "electron-builder build --publish always",
    "rebuild:electron": "electron-rebuild --force --only node-pty"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "18.4.5",
    "@oh-my-pi/pi-ai": "18.4.5",
    "@oh-my-pi/pi-catalog": "18.4.5",
    "@oh-my-pi/pi-coding-agent": "18.4.5",
    "@oh-my-pi/pi-utils": "18.4.5",
    "bun": "1.4.2",
    "compression": "^1.8.1",
    "electron-updater": "^6.0.0",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "typebox": "^1.3.14",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.10.0",
    "mermaid": "^11.17.2",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.7.2",
    "unified": "^11.0.5",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@41.10.7": true
  },
  "omp": {
    "extensions": [
      "./extensions"
    ]
  }
}
